pipeline{
    agent{
        label 'docker-agent'
    }
    stages{
        stage('checkout scm'){
            steps{checkout scm}
        }
        stage('Deploy Environment'){
            steps{
                sh 'docker compose -f deploy/docker-compose.yml up -d --build'
                sleep 3
            }
        }
        stage('Test container'){
            steps{
                sleep 10
                sh 'docker compose -f deploy/docker-compose.yml exec -T api wget -qO- http://localhost:8080'
            }
        }
    }
    post {
        always{
            sh 'docker compose -f deploy/docker-compose.yml down'
        }
        success{
            sh 'echo TASK EXECUTED SUCCESSFULLY' 
        }
        failure{
            sh 'echo TASK FAILED'
        }
    }
}